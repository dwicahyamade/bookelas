# Public site URL (used for magic-link copy actions in admin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (server-only; never expose SUPABASE_SERVICE_ROLE_KEY to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth (superadmin from env; branch admins from DB, managed via /admins UI)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
AUTH_SECRET=
AUTH_COOKIE_NAME=bookelas_admin
AUTH_MAX_AGE_SECONDS=43200

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=
